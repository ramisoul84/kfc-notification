# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
APP_NAME=kfc-notification
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production
APP_DEBUG=true

# ─────────────────────────────────────────────────────────────
# gRPC
# ─────────────────────────────────────────────────────────────
GRPC_PORT=9101
GRPC_SHUTDOWN_TIMEOUT=10s

# ─────────────────────────────────────────────────────────────
# Logger
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warn | error
LOG_FORMAT=text              # text | json
LOG_OUTPUT=stdout            # stdout | file | both
LOG_FILE_PATH=logs/app.log
LOG_SERVICE=kfc-notification

# ─────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────
# Provider: smtp | resend | log
EMAIL_PROVIDER=smtp

# Sender identity
EMAIL_FROM=noreply@kfc.ru
EMAIL_FROM_NAME=KFC Russia

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── Resend ───────────────────────────────────────────────────
RESEND_API_KEY=